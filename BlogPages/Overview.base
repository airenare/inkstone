views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder.startsWith("InkStone_Docs")
        - type != "listing"
        - type != "homepage"
        - file.ext == "md"
        - file.folder == "InkStone_Docs/writing"
    order:
      - file.name
      - file.folder
      - tags
    sort:
      - property: file.folder
        direction: ASC
      - property: priority
        direction: ASC
    columnSize:
      file.name: 171
      note.priority: 85
      note.menu_order: 83
