views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder.startsWith("InkStone_Docs")
        - type == "listing"
        - type != "homepage"
        - file.ext == "md"
    order:
      - file.name
      - featured
      - priority
      - menu_order
      - summary
      - date
      - file.folder
    sort:
      - property: file.folder
        direction: ASC
      - property: priority
        direction: ASC
    columnSize:
      file.name: 171
      note.priority: 85
      note.menu_order: 83
