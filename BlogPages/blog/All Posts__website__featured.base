title: All Blog Posts
summary: A database view of all blog posts.
filters:
  and:
    - file.inFolder("blog")
views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("blog")
    order:
      - file.name
      - file.folder
      - date
      - tags
      - website
      - type
      - summary
    sort:
      - property: date
        direction: DESC
