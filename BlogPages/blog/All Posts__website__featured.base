title: All Blog Posts
summary: A database view of all blog posts.

filters:
  and:
    - file.inFolder("blog")

views:
  - type: table
    name: Table
    filters:
      and:
        - file.tags.contains("inkstone")
    order:
      - file.name
      - file.folder
      - date
      - tags
      - website
      - type
      - summary
    sort:
      - column: date
        direction: DESC
